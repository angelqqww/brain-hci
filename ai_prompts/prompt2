Prompt to Kiro (Claude Opus 5.5):

how do i load these from a CDN

<script async src="https://docs.opencv.org/4.10.0/opencv.js" onload="onOpenCvLoaded()"></script>

Response:

Your tag is correct and loads OpenCV.js from the official CDN. The problem is timing. onload fires once the JavaScript file has downloaded, but OpenCV's WebAssembly runtime may still be starting up. If you call cv.Mat or cv.imread right away, you can get errors like "cv.Mat is not a constructor."

Make onOpenCvLoaded wait until OpenCV is actually ready. Here's a complete page that does that, then shows live edge detection from the webcam:

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>OpenCV.js Webcam Demo</title>
</head>
<body>
  <p id="status" role="status">Loading OpenCV.js...</p>
  <video id="video" width="640" height="480" autoplay playsinline muted></video>
  <canvas id="output" width="640" height="480" aria-label="Edge detection output"></canvas>

  <script>
    const statusEl = document.getElementById('status');

    // Called by the <script onload> below. Waits for the WASM runtime to be ready.
    async function onOpenCvLoaded() {
      if (cv instanceof Promise) {
        cv = await cv;                       // some builds expose cv as a Promise
      } else if (!cv.Mat) {
        await new Promise((resolve) => {     // others fire onRuntimeInitialized
          cv.onRuntimeInitialized = resolve;
        });
      }
      statusEl.textContent = 'OpenCV.js is ready.';
      startWebcam();
    }

    async function startWebcam() {
      const video = document.getElementById('video');
      try {
        video.srcObject = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        await video.play();
      } catch (err) {
        statusEl.textContent = 'Camera unavailable: ' + err.message;
        return;
      }

      // Allocate Mats once and reuse them every frame to avoid memory leaks
      const cap = new cv.VideoCapture(video);
      const src = new cv.Mat(video.height, video.width, cv.CV_8UC4);
      const gray = new cv.Mat();
      const edges = new cv.Mat();

      function processFrame() {
        cap.read(src);                                   // grab webcam frame
        cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY);      // convert to grayscale
        cv.Canny(gray, edges, 50, 150);                  // edge detection
        cv.imshow('output', edges);                      // draw to canvas
        requestAnimationFrame(processFrame);
      }
      requestAnimationFrame(processFrame);
    }
  </script>

  <!-- Load OpenCV.js last so onOpenCvLoaded is already defined -->
  <script async src="https://docs.opencv.org/4.10.0/opencv.js" onload="onOpenCvLoaded()"></script>
</body>
</html>

A few things to know:

- Load order: keep the OpenCV <script> after the script that defines onOpenCvLoaded, so the function already exists when onload fires.
- Memory: OpenCV.js doesn't clean up cv.Mat objects automatically. Reuse them as above, or call .delete() when you're done with one.
- Webcam access: browsers only allow it over HTTPS or localhost, so serve the page with python3 -m http.server 8000 and open http://localhost:8000. Opening the file directly may block the camera.
- Other docs: the OpenCV.js 4.10 usage tutorial (https://docs.opencv.org/4.10.0/d0/d84/tutorial_js_usage.html) takes a different approach. It defines a global Module = { onRuntimeInitialized() {...} } before the script tag instead of using onload. Either way works.

Other libraries load differently. MediaPipe, for example, uses an ES module import:

<script type="module">
  import { HandLandmarker, FilesetResolver } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14";
</script>

